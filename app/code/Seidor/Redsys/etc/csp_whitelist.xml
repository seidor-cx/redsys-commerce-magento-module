<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="connect-src">
            <values>
                <value id="redsys-app-builder" type="host">https://*.adobeioruntime.net</value>
                <value id="redsys-sandbox" type="host">https://sis-t.redsys.es:25443</value>
                <value id="redsys-production" type="host">https://sis.redsys.es</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="redsys-sandbox" type="host">https://sis-t.redsys.es:25443</value>
                <value id="redsys-production" type="host">https://sis.redsys.es</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="redsys-sandbox" type="host">https://sis-t.redsys.es:25443</value>
                <value id="redsys-production" type="host">https://sis.redsys.es</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
